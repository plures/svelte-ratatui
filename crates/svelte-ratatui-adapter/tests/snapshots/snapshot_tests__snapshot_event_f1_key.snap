(function(){
    const target = document.activeElement || document.body;
    target.dispatchEvent(new KeyboardEvent('keydown', {
        key: 'F1',
        code: 'F1',
        shiftKey: false,
        ctrlKey: false,
        altKey: false,
        metaKey: false,
        bubbles: true,
        cancelable: true
    }));
})()
